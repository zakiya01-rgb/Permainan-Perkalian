<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PERMAINAN PERKALIAN - Petualangan Doraemon</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Fredoka & Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        dora: {
                            blue: '#00A0E9',
                            darkblue: '#0072B5',
                            lightblue: '#E0F4FF',
                            red: '#E60012',
                            yellow: '#FFD100',
                            card: '#1E293B',
                            bg: '#0F172A'
                        }
                    },
                    fontFamily: {
                        fredoka: ['Fredoka', 'sans-serif'],
                        sans: ['Inter', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0F172A;
            color: #F8FAFC;
            overflow-x: hidden;
        }
        .font-game {
            font-family: 'Fredoka', cursive;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0F172A;
        }
        ::-webkit-scrollbar-thumb {
            background: #00A0E9;
            border-radius: 4px;
        }
        /* Float Animation for Bamboo Copter */
        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-10px) rotate(4deg); }
        }
        .animate-float {
            animation: float 3s ease-in-out infinite;
        }
        /* Doraemon Clouds Background Effect */
        .dora-bg {
            background-image: 
                radial-gradient(2px 2px at 30px 30px, #00A0E9, rgba(0,0,0,0)),
                radial-gradient(2px 2px at 70px 80px, #FFD100, rgba(0,0,0,0)),
                radial-gradient(1.5px 1.5px at 120px 40px, #E60012, rgba(0,0,0,0));
            background-repeat: repeat;
            background-size: 200px 200px;
        }
    </style>
</head>
<body class="dora-bg min-h-screen flex flex-col justify-between selection:bg-dora-yellow selection:text-slate-900">

    <!-- NAVIGATION HEADER -->
    <header class="bg-slate-900/90 backdrop-blur-md border-b border-dora-blue/40 sticky top-0 z-50 px-4 py-3">
        <div class="max-w-6xl mx-auto flex justify-between items-center">
            <div class="flex items-center gap-3 cursor-pointer" onclick="switchView('home')">
                <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-dora-blue to-cyan-400 flex items-center justify-center shadow-lg shadow-dora-blue/40 border border-white/20">
                    <i class="fa-solid fa-[#00A0E9] fa-bell text-dora-yellow text-xl animate-bounce"></i>
                </div>
                <div>
                    <h1 class="font-game text-xl sm:text-2xl font-bold bg-gradient-to-r from-dora-yellow via-white to-dora-blue bg-clip-text text-transparent">
                        PERMAINAN PERKALIAN
                    </h1>
                    <p class="text-[10px] sm:text-xs text-sky-300 -mt-1"><i class="fa-solid fa-fan text-dora-yellow mr-1"></i>Petualangan Baling-Baling Bambu</p>
                </div>
            </div>

            <!-- Current Profile / Login Indicator -->
            <div class="flex items-center gap-3">
                <div id="userProfileBadge" class="hidden sm:flex items-center gap-2 bg-slate-800 border border-dora-blue/50 px-3 py-1.5 rounded-full">
                    <i class="fa-solid fa-user-ninja text-dora-yellow"></i>
                    <span id="currentStudentNameDisplay" class="text-xs font-semibold text-sky-100">Siswa</span>
                </div>
                
                <button onclick="switchView('teacher-login')" class="bg-dora-red/80 hover:bg-dora-red border border-red-400 text-white text-xs sm:text-sm font-semibold px-3.5 py-2 rounded-xl transition flex items-center gap-2 shadow-md">
                    <i class="fa-solid fa-user-shield text-dora-yellow"></i>
                    <span>Area Guru</span>
                </button>
            </div>
        </div>
    </header>

    <!-- MAIN CONTAINER -->
    <main class="max-w-5xl mx-auto px-4 py-6 flex-grow w-full">

        <!-- ============================================================ -->
        <!-- VIEW 1: HALAMAN UTAMA SISWA (PETUALANGAN DORAEMON) -->
        <!-- ============================================================ -->
        <section id="view-home" class="space-y-8">
            <!-- Banner Misi Utama Doraemon -->
            <div class="bg-gradient-to-r from-slate-900 via-sky-950 to-slate-900 rounded-3xl p-6 sm:p-8 border-2 border-dora-blue/50 shadow-2xl relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-6">
                <div class="space-y-4 max-w-lg z-10 text-center md:text-left">
                    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-dora-blue/20 border border-dora-blue/50 text-sky-300 text-xs font-semibold">
                        <i class="fa-solid fa-cookie-bite text-amber-400"></i> Petualangan Kantong Ajaib
                    </div>
                    <h2 class="font-game text-3xl sm:text-4xl text-white leading-snug">
                        Kuasai Perkalian, Kumpulkan <span class="text-dora-yellow">8 Alat Canggih Doraemon!</span>
                    </h2>
                    <p class="text-sky-200 text-xs sm:text-sm leading-relaxed">
                        Pilih siswa, berlatih di 4 Game Seru, atau lakukan Setoran Resmi dengan Token dari guru untuk membuka checkpoint alat canggih!
                    </p>
                    
                    <!-- Select Student Profile -->
                    <div class="bg-slate-900/90 p-3 rounded-2xl border border-dora-blue/60 flex items-center justify-between gap-3">
                        <div class="text-xs text-sky-300 font-semibold pl-2">Identitas Siswa:</div>
                        <select id="studentSelectHeader" onchange="changeCurrentStudent(this.value)" class="bg-dora-blue border border-sky-300 text-white text-xs sm:text-sm font-bold rounded-xl px-3 py-2 focus:outline-none cursor-pointer">
                            <!-- Dynamic Options -->
                        </select>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex flex-col sm:flex-row gap-3 pt-2">
                        <button onclick="startPracticeMode()" class="w-full sm:w-auto bg-gradient-to-r from-dora-blue to-cyan-500 hover:from-cyan-400 hover:to-dora-blue text-slate-950 font-game font-bold text-base px-6 py-3.5 rounded-2xl shadow-lg shadow-dora-blue/30 hover:scale-105 transition flex items-center justify-center gap-2 border border-white/30">
                            <i class="fa-solid fa-gamepad text-lg"></i>
                            <span>MULAI LATIHAN MANDIRI</span>
                        </button>

                        <button onclick="openOfficialSessionModal()" class="w-full sm:w-auto bg-gradient-to-r from-dora-red to-rose-600 hover:from-rose-500 hover:to-dora-red text-white font-game font-bold text-base px-6 py-3.5 rounded-2xl shadow-lg shadow-dora-red/30 hover:scale-105 transition flex items-center justify-center gap-2 border border-white/20">
                            <i class="fa-solid fa-key text-dora-yellow text-lg"></i>
                            <span>SETORAN RESMI</span>
                        </button>
                    </div>
                </div>

                <!-- Visual Element Doraemon & Bamboo Copter -->
                <div class="relative w-48 h-48 sm:w-64 sm:h-64 flex items-center justify-center">
                    <div class="absolute inset-0 bg-dora-blue/20 rounded-full blur-2xl"></div>
                    <div class="animate-float text-center">
                        <div class="w-32 h-32 sm:w-40 sm:h-40 rounded-full bg-dora-blue border-4 border-white flex flex-col items-center justify-center mx-auto shadow-2xl relative">
                            <!-- Doraemon Bell -->
                            <div class="w-8 h-8 rounded-full bg-dora-yellow border-2 border-slate-900 flex items-center justify-center mb-1">
                                <div class="w-2 h-2 rounded-full bg-slate-900"></div>
                            </div>
                            <i class="fa-solid fa-face-smile text-white text-5xl"></i>
                            <!-- Collar -->
                            <div class="w-full h-3 bg-dora-red absolute bottom-4 border-t border-b border-slate-900"></div>
                        </div>
                        <div class="mt-3 text-[10px] font-mono text-dora-yellow uppercase tracking-widest bg-slate-900/90 px-3 py-1 rounded-full border border-dora-blue/60">
                            <i class="fa-solid fa-fan text-dora-yellow mr-1"></i> Baling-Baling Bambu Aktif
                        </div>
                    </div>
                </div>
            </div>

            <!-- Checkpoints Outer Space / Doraemon Gadgets Map -->
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="font-game text-xl text-dora-yellow flex items-center gap-2">
                            <i class="fa-solid fa-box-archive"></i> PETA CHECKPOINT ALAT DORAEMON (×2 s/d ×9)
                        </h3>
                        <p class="text-xs text-sky-300">Checkpoint hanya terbuka jika kamu LULUS Setoran Resmi dari guru!</p>
                    </div>
                    <div id="checkpointsProgressBadge" class="bg-slate-900 border border-dora-blue text-dora-yellow text-xs font-bold px-3 py-1.5 rounded-full">
                        0 / 8 Alat
                    </div>
                </div>

                <!-- Grid Checkpoints (x2 - x9) -->
                <div id="checkpointsGrid" class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                    <!-- Dynamic rendering by JS -->
                </div>
            </div>
        </section>

        <!-- ============================================================ -->
        <!-- VIEW 2: MODE LATIHAN MANDIRI (4 SUB-GAME SELECTION & ARENA) -->
        <!-- ============================================================ -->
        <section id="view-practice" class="hidden space-y-6">
            <!-- Header -->
            <div class="flex items-center justify-between bg-slate-900 p-4 rounded-2xl border border-dora-blue/50">
                <button onclick="switchView('home')" class="bg-slate-800 hover:bg-slate-700 text-sky-200 px-4 py-2 rounded-xl text-xs font-bold transition flex items-center gap-2">
                    <i class="fa-solid fa-arrow-left"></i> Kembali ke Menu
                </button>
                <h2 class="font-game text-xl text-dora-yellow flex items-center gap-2">
                    <i class="fa-solid fa-gamepad"></i> ARENA GAME LATIHAN MANDIRI
                </h2>
                <div></div>
            </div>

            <!-- Sub-Menu Selector Game & Tabel -->
            <div id="practiceTableSelector" class="space-y-6">
                <!-- Select Sub Game Menu -->
                <div class="bg-slate-900 p-6 rounded-3xl border border-dora-blue/50 space-y-4">
                    <h3 class="font-game text-xl text-center text-dora-yellow">1. PILIH JENIS PERMAINAN</h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3">
                        <!-- Game 1: Klasik Ketik -->
                        <div onclick="selectPracticeGameMode('classic')" id="gameModeCard-classic" class="cursor-pointer bg-slate-950 border-2 border-dora-blue hover:border-dora-yellow p-4 rounded-2xl text-center transition group">
                            <div class="w-12 h-12 rounded-xl bg-dora-blue/20 text-dora-blue flex items-center justify-center mx-auto text-2xl mb-2 group-hover:scale-110 transition">
                                <i class="fa-solid fa-keyboard"></i>
                            </div>
                            <h4 class="font-game text-sm text-white">Latihan Klasik</h4>
                            <p class="text-[10px] text-sky-300 mt-1">Ketik jawaban perkalian menggunakan tombol keypad.</p>
                        </div>

                        <!-- Game 2: Pilihan Ganda -->
                        <div onclick="selectPracticeGameMode('quiz')" id="gameModeCard-quiz" class="cursor-pointer bg-slate-950 border-2 border-slate-800 hover:border-dora-blue p-4 rounded-2xl text-center transition group">
                            <div class="w-12 h-12 rounded-xl bg-purple-500/20 text-purple-300 flex items-center justify-center mx-auto text-2xl mb-2 group-hover:scale-110 transition">
                                <i class="fa-solid fa-cookie-bite"></i>
                            </div>
                            <h4 class="font-game text-sm text-white">Tembak Dorayaki (PG)</h4>
                            <p class="text-[10px] text-sky-300 mt-1">Pilih 1 dari 4 dorayaki jawaban yang tepat.</p>
                        </div>

                        <!-- Game 3: Kartu Memori -->
                        <div onclick="selectPracticeGameMode('memory')" id="gameModeCard-memory" class="cursor-pointer bg-slate-950 border-2 border-slate-800 hover:border-dora-blue p-4 rounded-2xl text-center transition group">
                            <div class="w-12 h-12 rounded-xl bg-pink-500/20 text-pink-300 flex items-center justify-center mx-auto text-2xl mb-2 group-hover:scale-110 transition">
                                <i class="fa-solid fa-clone"></i>
                            </div>
                            <h4 class="font-game text-sm text-white">Kartu Memori</h4>
                            <p class="text-[10px] text-sky-300 mt-1">Jodohkan kartu soal dengan hasil perkaliannya.</p>
                        </div>

                        <!-- Game 4: Benar atau Salah -->
                        <div onclick="selectPracticeGameMode('truefalse')" id="gameModeCard-truefalse" class="cursor-pointer bg-slate-950 border-2 border-slate-800 hover:border-dora-blue p-4 rounded-2xl text-center transition group">
                            <div class="w-12 h-12 rounded-xl bg-amber-500/20 text-amber-300 flex items-center justify-center mx-auto text-2xl mb-2 group-hover:scale-110 transition">
                                <i class="fa-solid fa-circle-half-stroke"></i>
                            </div>
                            <h4 class="font-game text-sm text-white">Baling-Baling Benar/Salah</h4>
                            <p class="text-[10px] text-sky-300 mt-1">Tentukan dengan cepat apakah persamaan benar/salah.</p>
                        </div>
                    </div>
                </div>

                <!-- Select Table Perkalian -->
                <div class="bg-slate-900 p-6 rounded-3xl border border-dora-blue/50 text-center space-y-4">
                    <h3 class="font-game text-xl text-white">2. PILIH TABEL PERKALIAN</h3>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-2xl mx-auto">
                        <button onclick="startPracticeSession(2)" class="bg-slate-950 hover:bg-dora-blue border border-dora-blue/60 text-white p-3 rounded-2xl font-game text-lg transition">Perkalian 2</button>
                        <button onclick="startPracticeSession(3)" class="bg-slate-950 hover:bg-dora-blue border border-dora-blue/60 text-white p-3 rounded-2xl font-game text-lg transition">Perkalian 3</button>
                        <button onclick="startPracticeSession(4)" class="bg-slate-950 hover:bg-dora-blue border border-dora-blue/60 text-white p-3 rounded-2xl font-game text-lg transition">Perkalian 4</button>
                        <button onclick="startPracticeSession(5)" class="bg-slate-950 hover:bg-dora-blue border border-dora-blue/60 text-white p-3 rounded-2xl font-game text-lg transition">Perkalian 5</button>
                        <button onclick="startPracticeSession(6)" class="bg-slate-950 hover:bg-dora-blue border border-dora-blue/60 text-white p-3 rounded-2xl font-game text-lg transition">Perkalian 6</button>
                        <button onclick="startPracticeSession(7)" class="bg-slate-950 hover:bg-dora-blue border border-dora-blue/60 text-white p-3 rounded-2xl font-game text-lg transition">Perkalian 7</button>
                        <button onclick="startPracticeSession(8)" class="bg-slate-950 hover:bg-dora-blue border border-dora-blue/60 text-white p-3 rounded-2xl font-game text-lg transition">Perkalian 8</button>
                        <button onclick="startPracticeSession(9)" class="bg-slate-950 hover:bg-dora-blue border border-dora-blue/60 text-white p-3 rounded-2xl font-game text-lg transition">Perkalian 9</button>
                    </div>
                </div>
            </div>

            <!-- Interactive Playing Container -->
            <div id="practiceInteractiveArea" class="hidden bg-slate-900 p-6 sm:p-8 rounded-3xl border-2 border-dora-blue max-w-xl mx-auto space-y-6 shadow-2xl relative">
                <!-- Score & Game Header -->
                <div class="flex justify-between items-center text-xs font-semibold text-sky-200 border-b border-slate-800 pb-3">
                    <div>
                        Game: <span id="practiceGameTitleDisplay" class="text-dora-yellow font-bold">Klasik</span> 
                        (<span id="practiceTargetTitle" class="text-dora-blue font-bold">x2</span>)
                    </div>
                    <div>Skor: <span id="practiceScoreCounter" class="text-dora-yellow font-bold text-lg">0</span></div>
                </div>

                <!-- SUB-GAME 1: KLASIK KETIK -->
                <div id="subGameClassic" class="hidden space-y-4 text-center">
                    <div class="py-2">
                        <div class="text-xs uppercase tracking-wider text-sky-300 mb-2">Berapakah Hasil Dari:</div>
                        <div id="practiceQuestionText" class="font-game text-5xl sm:text-6xl text-white tracking-widest bg-slate-950 py-5 rounded-2xl border-2 border-dora-blue shadow-inner">
                            2 × 4 = ?
                        </div>
                    </div>

                    <div class="space-y-4">
                        <div class="flex gap-2 max-w-xs mx-auto">
                            <input type="number" id="practiceAnswerInput" placeholder="Jawaban..." readonly class="w-full bg-slate-950 border-2 border-dora-blue rounded-xl px-4 py-3 text-center text-3xl font-game text-white focus:outline-none">
                            <button onclick="submitPracticeAnswer()" class="bg-dora-blue hover:bg-cyan-400 text-slate-950 font-game font-bold text-xl px-6 py-3 rounded-xl transition">Kirim</button>
                        </div>
                        <div class="grid grid-cols-3 gap-2 max-w-xs mx-auto pt-2">
                            <button onclick="appendNum('practiceAnswerInput', '1')" class="bg-slate-950 hover:bg-slate-800 text-white font-game text-2xl py-3 rounded-xl border border-slate-700">1</button>
                            <button onclick="appendNum('practiceAnswerInput', '2')" class="bg-slate-950 hover:bg-slate-800 text-white font-game text-2xl py-3 rounded-xl border border-slate-700">2</button>
                            <button onclick="appendNum('practiceAnswerInput', '3')" class="bg-slate-950 hover:bg-slate-800 text-white font-game text-2xl py-3 rounded-xl border border-slate-700">3</button>
                            <button onclick="appendNum('practiceAnswerInput', '4')" class="bg-slate-950 hover:bg-slate-800 text-white font-game text-2xl py-3 rounded-xl border border-slate-700">4</button>
                            <button onclick="appendNum('practiceAnswerInput', '5')" class="bg-slate-950 hover:bg-slate-800 text-white font-game text-2xl py-3 rounded-xl border border-slate-700">5</button>
                            <button onclick="appendNum('practiceAnswerInput', '6')" class="bg-slate-950 hover:bg-slate-800 text-white font-game text-2xl py-3 rounded-xl border border-slate-700">6</button>
                            <button onclick="appendNum('practiceAnswerInput', '7')" class="bg-slate-950 hover:bg-slate-800 text-white font-game text-2xl py-3 rounded-xl border border-slate-700">7</button>
                            <button onclick="appendNum('practiceAnswerInput', '8')" class="bg-slate-950 hover:bg-slate-800 text-white font-game text-2xl py-3 rounded-xl border border-slate-700">8</button>
                            <button onclick="appendNum('practiceAnswerInput', '9')" class="bg-slate-950 hover:bg-slate-800 text-white font-game text-2xl py-3 rounded-xl border border-slate-700">9</button>
                            <button onclick="clearNum('practiceAnswerInput')" class="bg-dora-red hover:bg-rose-600 text-white font-bold py-3 rounded-xl border border-red-400">C</button>
                            <button onclick="appendNum('practiceAnswerInput', '0')" class="bg-slate-950 hover:bg-slate-800 text-white font-game text-2xl py-3 rounded-xl border border-slate-700">0</button>
                            <button onclick="submitPracticeAnswer()" class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold py-3 rounded-xl border border-emerald-400"><i class="fa-solid fa-check"></i></button>
                        </div>
                    </div>
                </div>

                <!-- SUB-GAME 2: QUIZ PILIHAN GANDA -->
                <div id="subGameQuiz" class="hidden space-y-6 text-center">
                    <div class="py-2">
                        <div class="text-xs uppercase tracking-wider text-amber-300 mb-2">Pilih Dorayaki Jawaban Yang Benar:</div>
                        <div id="quizQuestionText" class="font-game text-5xl sm:text-6xl text-white tracking-widest bg-slate-950 py-5 rounded-2xl border-2 border-dora-yellow shadow-inner">
                            3 × 5 = ?
                        </div>
                    </div>

                    <div id="quizOptionsGrid" class="grid grid-cols-2 gap-3 max-w-sm mx-auto">
                        <!-- Dynamic Options rendered by JS -->
                    </div>
                </div>

                <!-- SUB-GAME 3: KARTU MEMORI -->
                <div id="subGameMemory" class="hidden space-y-4 text-center">
                    <div class="text-xs text-sky-300">Temukan & Jodohkan Pasangan Kartu Soal dan Jawabannya!</div>
                    <div id="memoryCardsGrid" class="grid grid-cols-3 sm:grid-cols-4 gap-2 max-w-md mx-auto">
                        <!-- Dynamic Memory Cards -->
                    </div>
                </div>

                <!-- SUB-GAME 4: BENAR / SALAH -->
                <div id="subGameTrueFalse" class="hidden space-y-6 text-center">
                    <div class="py-2">
                        <div class="text-xs uppercase tracking-wider text-amber-300 mb-2">Apakah Pernyataan Ini Benar?</div>
                        <div id="tfQuestionText" class="font-game text-4xl sm:text-5xl text-white tracking-widest bg-slate-950 py-6 rounded-2xl border-2 border-dora-yellow shadow-inner">
                            2 × 8 = 16
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4 max-w-xs mx-auto">
                        <button onclick="submitTFAnswer(true)" class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-game text-2xl font-bold py-4 rounded-2xl shadow-lg border-2 border-white transition flex flex-col items-center gap-1">
                            <i class="fa-solid fa-circle-check text-3xl"></i>
                            BENAR
                        </button>
                        <button onclick="submitTFAnswer(false)" class="bg-dora-red hover:bg-rose-500 text-white font-game text-2xl font-bold py-4 rounded-2xl shadow-lg border-2 border-white transition flex flex-col items-center gap-1">
                            <i class="fa-solid fa-circle-xmark text-3xl"></i>
                            SALAH
                        </button>
                    </div>
                </div>

                <!-- Immediate Feedback Message -->
                <div id="practiceFeedback" class="hidden p-3 rounded-xl font-bold text-center text-sm"></div>

                <!-- Back to Practice Selection -->
                <button onclick="startPracticeMode()" class="w-full bg-slate-950 hover:bg-slate-800 border border-dora-blue/50 text-sky-300 py-2.5 rounded-xl text-xs font-bold transition">
                    <i class="fa-solid fa-rotate-left mr-1"></i> Ganti Jenis Game / Perkalian
                </button>
            </div>
        </section>

        <!-- ============================================================ -->
        <!-- VIEW 3: MODE SETORAN RESMI (EXAM SCREEN) -->
        <!-- ============================================================ -->
        <section id="view-official-exam" class="hidden max-w-xl mx-auto space-y-6">
            <div class="bg-slate-900 p-6 sm:p-8 rounded-3xl border-2 border-dora-red shadow-2xl space-y-6 text-center">
                <!-- Header Info & Timer -->
                <div class="flex justify-between items-center bg-slate-950 p-3 rounded-2xl border border-slate-800 text-xs font-bold">
                    <div class="text-dora-red flex items-center gap-1">
                        <i class="fa-solid fa-shield-halved"></i> <span id="examTargetText">Tabel Perkalian 2</span>
                    </div>
                    <div class="text-dora-yellow">
                        TOKEN: <span id="examTokenBadge" class="font-mono bg-dora-blue px-2 py-0.5 rounded text-white">PER2A</span>
                    </div>
                </div>

                <!-- Progress & Timer Ring -->
                <div class="space-y-2">
                    <div class="flex justify-between text-xs text-sky-200 font-semibold">
                        <span>Soal No. <span id="examQuestionNum" class="text-white font-bold">1</span> dari 20</span>
                        <span>Waktu Per Soal</span>
                    </div>
                    
                    <div class="w-full bg-slate-950 rounded-full h-3 border border-slate-800 overflow-hidden">
