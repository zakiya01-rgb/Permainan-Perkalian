                AudioFX.playWrong();
                feedbackEl.className = "p-3 rounded-xl font-bold text-center text-xs bg-rose-500/20 text-rose-300 border border-rose-500/50";
                feedbackEl.innerHTML = `<i class="fa-solid fa-circle-xmark mr-1"></i> Kurang Tepat! (${solutionMsg})`;
            }
        }

