            }
        }

        function deleteStudent(studentId) {
            if (confirm('Apakah Anda yakin ingin menghapus data siswa ini?')) {
                state.students = state.students.filter(s => s.id !== studentId);
                if (state.currentStudentId === studentId && state.students.length > 0) {
                    state.currentStudentId = state.students[0].id;
                }
                saveData();
                renderTeacherDashboard();
            }
        }

        function renderTeacherDashboard() {
            // Stats summary calculation
            const totalS = state.students.length;
            const passedS = state.students.filter(s => s.unlockedCheckpoints && s.unlockedCheckpoints.length > 0).length;
            
            const studentExamSet = new Set(state.examResults.map(r => r.studentId));
            const pendingS = state.students.filter(s => !studentExamSet.has(s.id)).length;
            const failedS = Math.max(0, totalS - passedS - pendingS);

            document.getElementById('teacherTotalStudents').textContent = totalS;
            document.getElementById('teacherPassedCount').textContent = passedS;
            document.getElementById('teacherFailedCount').textContent = failedS;
            document.getElementById('teacherPendingCount').textContent = pendingS;

            // Render Active Sessions Table
            const sessionTbody = document.getElementById('teacherActiveSessionsTable');
            sessionTbody.innerHTML = state.sessions.length === 0 
                ? `<tr><td colspan="5" class="p-4 text-center text-sky-400">Belum ada sesi setoran resmi.</td></tr>`
                : state.sessions.map(s => `
                    <tr class="hover:bg-slate-950/40">
                        <td class="p-3 font-mono font-bold text-dora-yellow text-sm">${s.token}</td>
                        <td class="p-3 font-bold text-white">Perkalian ${s.targetTable}</td>
                        <td class="p-3">${s.timerSeconds} Detik</td>
                        <td class="p-3">${s.passingGrade} / 20 Soal</td>
                        <td class="p-3 text-right">
                            <button onclick="toggleSessionActive('${s.id}')" class="px-2.5 py-1 rounded-lg text-[10px] font-bold ${s.active ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/50' : 'bg-gray-700 text-gray-300'}">
                                ${s.active ? 'AKTIF (Klik Nonaktifkan)' : 'NONAKTIF'}
                            </button>
                        </td>
                    </tr>
                `).join('');

            // Render Students List Table
            const studentTbody = document.getElementById('teacherStudentListTable');
            studentTbody.innerHTML = state.students.map(s => {
                const unlocked = s.unlockedCheckpoints || [];
                const totalExams = state.examResults.filter(r => r.studentId === s.id).length;
                const cpBadges = unlocked.length === 0 
                    ? `<span class="text-slate-500 italic">Belum ada (BELUM SETOR / LULUS)</span>`
                    : unlocked.map(t => `<span class="bg-slate-800 border border-dora-blue/50 text-sky-200 px-2 py-0.5 rounded text-[10px] font-bold mr-1">×${t}</span>`).join('');

                return `
                    <tr class="hover:bg-slate-950/40">
                        <td class="p-3 font-bold text-white">${s.name}</td>
                        <td class="p-3">${cpBadges}</td>
                        <td class="p-3">${totalExams} Kali Sesi</td>
                        <td class="p-3 text-right space-x-2">
                            <button onclick="openEditStudentModal('${s.id}')" class="text-dora-yellow hover:text-amber-300 font-bold p-1" title="Edit Nama Siswa">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </button>
                            <button onclick="deleteStudent('${s.id}')" class="text-dora-red hover:text-rose-300 font-bold p-1" title="Hapus Siswa">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');

            // Render Exam History Table
            const historyTbody = document.getElementById('teacherExamHistoryTable');
            historyTbody.innerHTML = state.examResults.length === 0
                ? `<tr><td colspan="6" class="p-4 text-center text-sky-400">Belum ada riwayat pengerjaan setoran siswa.</td></tr>`
                : state.examResults.slice(0, 15).map(r => `
                    <tr class="hover:bg-slate-950/40">
                        <td class="p-3 text-sky-400 text-[10px]">${r.timestamp}</td>
                        <td class="p-3 font-bold text-white">${r.studentName}</td>
                        <td class="p-3">Perkalian ${r.targetTable}</td>
                        <td class="p-3">${r.correctCount} Benar / ${r.wrongCount} Salah</td>
                        <td class="p-3 font-bold ${r.score >= 75 ? 'text-emerald-400' : 'text-dora-red'}">${r.score}</td>
                        <td class="p-3">
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold ${r.isPassed ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40' : 'bg-dora-red/20 text-rose-300 border border-dora-red/40'}">
                                ${r.isPassed ? 'LULUS' : 'GAGAL'}
                            </span>
                        </td>
                    </tr>
                `).join('');
        }

        /* Initial boot */
        window.onload = function() {
            renderHomeView();
        };
    </script>
</body>
</html>