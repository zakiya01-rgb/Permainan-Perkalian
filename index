        // Load or init state from localStorage
        let state = {
            students: JSON.parse(localStorage.getItem('pk_students')) || DEFAULT_STUDENTS,
            sessions: JSON.parse(localStorage.getItem('pk_sessions')) || DEFAULT_SESSIONS,
            examResults: JSON.parse(localStorage.getItem('pk_results')) || [],
            currentStudentId: localStorage.getItem('pk_current_student_id') || 's1'
        };

        function saveData() {
            localStorage.setItem('pk_students', JSON.stringify(state.students));
            localStorage.setItem('pk_sessions', JSON.stringify(state.sessions));
            localStorage.setItem('pk_results', JSON.stringify(state.examResults));
            localStorage.setItem('pk_current_student_id', state.currentStudentId);
        }

        /* Checkpoint Definitions Doraemon Gadgets (2 to 9) */
        const CHECKPOINTS = [
            { table: 2, name: 'Baling-Baling Bambu', icon: 'fa-fan', color: 'from-dora-blue to-cyan-600' },
