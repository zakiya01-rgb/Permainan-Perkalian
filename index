        // --- GAME 1: KLASIK ---
        function nextPracticeQuestionClassic() {
            practiceState.num1 = practiceState.table;
            practiceState.num2 = getNextMultiplier();
            practiceState.correctAnswer = practiceState.num1 * practiceState.num2;

            document.getElementById('practiceQuestionText').textContent = `${practiceState.num1} × ${practiceState.num2} = ?`;
            document.getElementById('practiceAnswerInput').value = '';
            document.getElementById('practiceFeedback').classList.add('hidden');
        }

        function submitPracticeAnswer() {
            const val = parseInt(document.getElementById('practiceAnswerInput').value);
            checkAnswer(val === practiceState.correctAnswer, `${practiceState.num1} × ${practiceState.num2} = ${practiceState.correctAnswer}`, nextPracticeQuestionClassic);
        }

        // --- GAME 2: PILIHAN GANDA ---
        function nextPracticeQuestionQuiz() {
            practiceState.num1 = practiceState.table;
            practiceState.num2 = getNextMultiplier();
            practiceState.correctAnswer = practiceState.num1 * practiceState.num2;

            document.getElementById('quizQuestionText').textContent = `${practiceState.num1} × ${practiceState.num2} = ?`;
            document.getElementById('practiceFeedback').classList.add('hidden');

            // Generate 4 unique options including correct answer
            let options = new Set([practiceState.correctAnswer]);
            while (options.size < 4) {
                let fakeAns = practiceState.table * (Math.floor(Math.random() * 10) + 1) + (Math.random() < 0.5 ? 1 : -1);
                if (fakeAns > 0 && fakeAns !== practiceState.correctAnswer) options.add(fakeAns);
            }
            let optionsArray = Array.from(options).sort(() => Math.random() - 0.5);

            const grid = document.getElementById('quizOptionsGrid');
            grid.innerHTML = optionsArray.map(opt => `
                <button onclick="submitQuizOption(${opt})" class="bg-slate-950 hover:bg-dora-blue border border-dora-yellow text-white font-game text-2xl py-4 rounded-2xl transition transform active:scale-95 shadow-md flex items-center justify-center gap-2">
                    <i class="fa-solid fa-cookie-bite text-xs text-dora-yellow"></i> ${opt}
                </button>
            `).join('');
        }

        function submitQuizOption(val) {
            checkAnswer(val === practiceState.correctAnswer, `${practiceState.num1} × ${practiceState.num2} = ${practiceState.correctAnswer}`, nextPracticeQuestionQuiz);
        }

        // --- GAME 3: KARTU MEMORI ---
        function setupMemoryGame() {
            document.getElementById('practiceFeedback').classList.add('hidden');
            practiceState.selectedCards = [];

            // Pick 4 multiplication facts for table without repeats until exhausted
            let multipliers = [];
            for (let i = 0; i < 4; i++) {
                multipliers.push(getNextMultiplier());
            }
            let cards = [];

            multipliers.forEach((m, idx) => {
                cards.push({ id: `q_${idx}`, pairId: idx, text: `${practiceState.table} × ${m}`, type: 'question' });
                cards.push({ id: `a_${idx}`, pairId: idx, text: `${practiceState.table * m}`, type: 'answer' });
            });

            cards.sort(() => Math.random() - 0.5);
            practiceState.memoryCards = cards;

            renderMemoryCards();
        }

        function renderMemoryCards() {
            const grid = document.getElementById('memoryCardsGrid');
            grid.innerHTML = practiceState.memoryCards.map((card, idx) => `
                <button id="memCard_${idx}" onclick="flipMemoryCard(${idx})" class="h-20 bg-slate-950 hover:bg-slate-800 border-2 border-dora-blue rounded-xl font-game text-base text-white flex items-center justify-center transition p-2">
                    <i class="fa-solid fa-bell text-dora-yellow text-xl"></i>
                </button>
            `).join('');
        }

        function flipMemoryCard(idx) {
            if (practiceState.selectedCards.length >= 2) return;
            const card = practiceState.memoryCards[idx];
            const cardEl = document.getElementById(`memCard_${idx}`);

            if (cardEl.classList.contains('matched') || practiceState.selectedCards.some(c => c.index === idx)) return;

            cardEl.innerHTML = `<span class="text-dora-yellow font-bold">${card.text}</span>`;
            cardEl.classList.add('border-dora-red');

            practiceState.selectedCards.push({ index: idx, data: card });

            if (practiceState.selectedCards.length === 2) {
                const [c1, c2] = practiceState.selectedCards;
                if (c1.data.pairId === c2.data.pairId) {
                    // Match found
                    AudioFX.playCorrect();
                    practiceState.score += 5;
                    document.getElementById('practiceScoreCounter').textContent = practiceState.score;
                    
                    document.getElementById(`memCard_${c1.index}`).className = "h-20 bg-emerald-950/80 border-2 border-emerald-500 rounded-xl font-game text-emerald-300 flex items-center justify-center p-2 matched";
                    document.getElementById(`memCard_${c2.index}`).className = "h-20 bg-emerald-950/80 border-2 border-emerald-500 rounded-xl font-game text-emerald-300 flex items-center justify-center p-2 matched";
                    
                    practiceState.selectedCards = [];

                    // Check if all matched
                    const matchedCount = document.querySelectorAll('.matched').length;
                    if (matchedCount >= practiceState.memoryCards.length) {
                        setTimeout(() => {
                            const feedbackEl = document.getElementById('practiceFeedback');
                            feedbackEl.classList.remove('hidden');
                            feedbackEl.className = "p-3 rounded-xl font-bold text-center text-xs bg-emerald-500/20 text-emerald-300 border border-emerald-500/50";
                            feedbackEl.innerHTML = `<i class="fa-solid fa-trophy mr-1"></i> Hebat! Semua Kartu Terjodohkan! Mengacak kartu baru...`;
                            setTimeout(setupMemoryGame, 1800);
                        }, 500);
                    }
                } else {
                    // Not matched
                    AudioFX.playWrong();
                    setTimeout(() => {
                        renderMemoryCardReset(c1.index);
                        renderMemoryCardReset(c2.index);
                        practiceState.selectedCards = [];
                    }, 1000);
                }
            }
        }

        function renderMemoryCardReset(idx) {
            const cardEl = document.getElementById(`memCard_${idx}`);
            if (cardEl && !cardEl.classList.contains('matched')) {
                cardEl.innerHTML = `<i class="fa-solid fa-bell text-dora-yellow text-xl"></i>`;
                cardEl.classList.remove('border-dora-red');
            }
        }

        // --- GAME 4: BENAR / SALAH ---
        function nextPracticeQuestionTF() {
            practiceState.num1 = practiceState.table;
            practiceState.num2 = getNextMultiplier();
            practiceState.correctAnswer = practiceState.num1 * practiceState.num2;
            
            // 50% chance of showing correct claim vs fake claim
            practiceState.isTFClaimCorrect = Math.random() < 0.5;
            if (practiceState.isTFClaimCorrect) {
                practiceState.tfClaimAnswer = practiceState.correctAnswer;
            } else {
                practiceState.tfClaimAnswer = practiceState.correctAnswer + (Math.random() < 0.5 ? 2 : -1);
                if (practiceState.tfClaimAnswer === practiceState.correctAnswer) practiceState.tfClaimAnswer += 3;
            }

            document.getElementById('tfQuestionText').textContent = `${practiceState.num1} × ${practiceState.num2} = ${practiceState.tfClaimAnswer}`;
            document.getElementById('practiceFeedback').classList.add('hidden');
        }

        function submitTFAnswer(userThoughtTrue) {
            const isCorrect = userThoughtTrue === practiceState.isTFClaimCorrect;
            checkAnswer(isCorrect, `${practiceState.num1} × ${practiceState.num2} = ${practiceState.correctAnswer}`, nextPracticeQuestionTF);
        }

        // General feedback & score handler for games
